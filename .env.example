# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3000

# Product name shown by the server (page titles, share previews).
APP_NAME=Pulse Studio

# How many reverse proxies sit in front of the app. Behind Coolify (Traefik) AND a Cloudflare tunnel use 2.
# Running locally without a proxy: 0. This matters: it decides which IP the login rate limit sees.
TRUST_PROXY=2

# Public address of the app (used for CORS/origin checks), e.g. the tunnel subdomain.
PUBLIC_URL=https://studio.puma-code.com
ALLOWED_ORIGINS=https://studio.puma-code.com

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# trial = invited users only, no billing. (subscription is reserved for later.)
APP_MODE=trial

# First super admin. It is created on first start only if no super admin exists.
# After the first start, delete SUPERADMIN_PASSWORD from this file.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Any chat model your key can use. List the exact names with: npm run ai:models
OPENAI_MODEL=gpt-4o-mini
# Reasoning models spend part of this on hidden thinking, so keep it generous.
OPENAI_MAX_OUTPUT_TOKENS=6000
# Optional, reasoning models only: low | medium | high. Leave empty for other models.
OPENAI_REASONING_EFFORT=
# USD per 1M tokens of the model you chose (check openai.com/api/pricing).
# Used only to estimate spend, so update these whenever you change the model.
OPENAI_PRICE_IN_PER_M=0.15
OPENAI_PRICE_OUT_PER_M=0.60
# Hard stop for the whole app each month (USD). Set the same limit in the OpenAI dashboard too.
AI_MONTHLY_BUDGET_USD=5

# --- Default quotas for new users (the super admin can change them per user) -----
DEFAULT_AI_MONTHLY_QUOTA=20
DEFAULT_MASTER_DAILY_QUOTA=5
# AI voices (text to speech). Each NEW phrase costs a little; the same phrase is cached and free.
DEFAULT_VOICE_MONTHLY_QUOTA=10
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=coral
OPENAI_TTS_VOICE_MALE=onyx
# Estimate used for the monthly budget (USD per 1000 characters).
OPENAI_TTS_PRICE_PER_1K_CHARS=0.02
# Max characters of the prompt the AI receives (clicks + free text).
MAX_PROMPT_CHARS=1500

# --- Mastering ----------------------------------------------------------------
MASTER_CONCURRENCY=1
# Cloudflare rejects request bodies over 100 MB, so every file is uploaded in its own request (limit per file).
MAX_UPLOAD_MB=95
MAX_AUDIO_SECONDS=480
JOB_TTL_HOURS=24

# Where the database and generated files live (mounted as a volume in Docker).
# DATA_DIR=./data
